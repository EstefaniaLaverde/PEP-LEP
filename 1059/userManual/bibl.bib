@article{ballet_multiplication_2021,
	title = {Multiplication in finite fields with {Chudnovsky}-type algorithms on the projective line},
	url = {http://arxiv.org/abs/2007.16082},
	abstract = {We propose a Recursive Polynomial Generic Construction (RPGC) of multiplication algorithms in any ﬁnite ﬁeld Fqn based on the method of D.V. and G.V. Chudnovsky specialized on the projective line. They are usual polynomial interpolation algorithms in small extensions and the Karatsuba algorithm is seen as a particular case of this construction. Using an explicit family of such algorithms, we show that their bilinear complexity is quasi-linear with respect to the extension degree n, and we give a uniform bound for this complexity. We also prove that the construction of these algorithms is deterministic and can be done in polynomial time. We give an asymptotic bound for the complexity of their construction.},
	language = {en},
	urldate = {2022-04-01},
	journal = {arXiv:2007.16082 [math]},
	author = {Ballet, Stéphane and Bonnecaze, Alexis and Pacifico, Bastien},
	
	year = {2021},
	note = {arXiv: 2007.16082},
	keywords = {Mathematics - Algebraic Geometry},
	annote = {Comment: 30 pages},
